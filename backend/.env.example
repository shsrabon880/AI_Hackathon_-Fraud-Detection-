APP_NAME=FinSphere AI - FraudShield
ENVIRONMENT=development
DATABASE_URL=sqlite:///./fraudshield.db
SECRET_KEY=replace-with-64-char-random-secret-key
ENCRYPTION_KEY=replace-with-fernet-base64-32-byte-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Email OTP Delivery (Configure either Resend API OR SMTP e.g. Gmail App Password)
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
